@{
    var usuarioNome = Context.Session.GetString("UsuarioNome");
    var usuarioTipo = Context.Session.GetString("UsuarioTipo");
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LanPets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🐾 LanPets</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Produto" asp-action="Index">Produtos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Agendamento" asp-action="Index">Agendar</a></li>
                    <li class="nav-item">
                        <a class="nav-link cart-link" asp-controller="Cart" asp-action="Index">
                            🛒 Carrinho
                            @if (Context.Session.GetCart().Count > 0)
                            {
                                <span class="badge bg-light text-success ms-1">@Context.Session.GetCart().Count</span>
                            }
                        </a>
                    </li>

                    @if (!string.IsNullOrEmpty(usuarioNome))
                    {
                        if (usuarioTipo == "admin")
                        {
                            <li class="nav-item"><a class="nav-link fw-bold text-warning admin-link" asp-controller="Admin" asp-action="Index">Painel Admin</a></li>
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-pill" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                👤 @usuarioNome
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="MeusPedidos">Meus pedidos</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Sair</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link btn-login ms-2" asp-controller="Account" asp-action="Login">Entrar</a></li>
                        <li class="nav-item"><a class="nav-link btn-login ms-2" asp-controller="Account" asp-action="Register">Cadastrar</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Mensagem"] is string mensagem)
            {
                <div class="alert alert-info text-center mt-4">@mensagem</div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="mt-5 text-center text-white py-4">
        <div class="container">
            <p class="mb-0 fw-semibold">© @DateTime.Now.Year LanPets - Todos os direitos reservados 🐶💚</p>
            <p class="mb-0">Feito com carinho pela equipe da LanPets</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
