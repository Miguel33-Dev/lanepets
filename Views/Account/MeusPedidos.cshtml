@using System.Globalization
@model List<PetshopCSharp.Models.Pedido>
@{
    ViewData["Title"] = "Meus Pedidos";
    var ptBr = new CultureInfo("pt-BR");
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <p class="text-success fw-semibold mb-1">Minha conta</p>
            <h2 class="mb-0">Meus pedidos</h2>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-success">Continuar comprando</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-cart text-center">
            <h4 class="text-success">Você ainda não fez nenhum pedido.</h4>
            <p class="text-muted mb-0">Explore a loja e escolha o melhor para seu pet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle table-bordered order-history-table">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Itens</th>
                        <th>Data</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Detalhes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in Model)
                    {
                        var statusClass = pedido.Status switch
                        {
                            "Confirmado" => "status-confirmado",
                            "Em preparação" => "status-preparacao",
                            "Saiu para entrega" => "status-entrega",
                            "Entregue" => "status-entregue",
                            "Cancelado" => "status-cancelado",
                            _ => "status-default"
                        };

                        <tr>
                            <td class="fw-bold">#@pedido.Id</td>
                            <td>@pedido.Itens.Count item(ns)</td>
                            <td>@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@pedido.Total.ToString("C2", ptBr)</td>
                            <td><span class="badge @statusClass">@pedido.Status</span></td>
                            <td>
                                <a asp-action="DetalhesPedido" asp-route-id="@pedido.Id" class="btn btn-outline-success btn-sm">Visualizar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
