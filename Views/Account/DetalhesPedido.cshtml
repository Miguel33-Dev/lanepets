@using System.Globalization
@model PetshopCSharp.Models.Pedido
@{
    ViewData["Title"] = "Detalhes do Pedido";
    var ptBr = new CultureInfo("pt-BR");
    var statusClass = Model.Status switch
    {
        "Confirmado" => "status-confirmado",
        "Em preparação" => "status-preparacao",
        "Saiu para entrega" => "status-entrega",
        "Entregue" => "status-entregue",
        "Cancelado" => "status-cancelado",
        _ => "status-default"
    };
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <p class="text-success fw-semibold mb-1">Pedido</p>
            <h2 class="mb-0">#@Model.Id</h2>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge @statusClass">@Model.Status</span>
            <a asp-action="MeusPedidos" class="btn btn-outline-success">Voltar</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card p-4">
                <h4 class="text-success mb-3">Produtos</h4>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Qtd.</th>
                                <th>Preço unit.</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Itens)
                            {
                                <tr>
                                    <td>@item.ProdutoNome</td>
                                    <td>@item.Quantidade</td>
                                    <td>@item.PrecoUnitario.ToString("C2", ptBr)</td>
                                    <td>@((item.Quantidade * item.PrecoUnitario).ToString("C2", ptBr))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-4">
                <h4 class="text-success mb-3">Resumo do pedido</h4>
                <div class="d-flex justify-content-between mb-2">
                    <span>Data</span>
                    <strong>@Model.DataPedido.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Cliente</span>
                    <strong>@Model.NomeCliente</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Telefone</span>
                    <strong>@Model.Telefone</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Pagamento</span>
                    <strong>@Model.FormaPagamento</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Endereço</span>
                    <strong>@Model.Endereco</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Observacao))
                {
                    <div class="mt-3">
                        <span class="text-muted d-block mb-1">Observação</span>
                        <div class="p-3 rounded bg-light">@Model.Observacao</div>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Total</span>
                    <span class="fw-bold text-success fs-5">@Model.Total.ToString("C2", ptBr)</span>
                </div>
            </div>
        </div>
    </div>
</div>
