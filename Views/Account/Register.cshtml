@model PetshopCSharp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Cadastro";
}

<div class="auth-shell">
    <div class="auth-layout">
        <div class="auth-side">
            <div class="auth-crest">🐾</div>
            <h2>Crie sua conta</h2>
            <p>Junte-se à LanPets e tenha acesso ao melhor para o seu pet: compras, agendamentos, suporte e cuidados personalizados.</p>
            <ul class="auth-highlight-list">
                <li>✔ Cadastro rápido</li>
                <li>✔ Acesso ao histórico de pedidos</li>
                <li>✔ Serviços e produtos em um só lugar</li>
            </ul>
        </div>

        <div class="card auth-form-panel">
            <div class="text-center mb-4">
                <div class="display-6 mb-2">🐾</div>
                <h3 class="text-success fw-bold mb-1">Criar Conta</h3>
                <p class="text-muted mb-0">Cadastre-se para agendar serviços e comprar com facilidade.</p>
            </div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">Nome completo</label>
                    <input asp-for="Nome" class="form-control" placeholder="Seu nome" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-control" placeholder="seuemail@exemplo.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Senha" class="form-label">Senha</label>
                    <input asp-for="Senha" class="form-control" placeholder="Crie uma senha" type="password" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">Cadastrar e Continuar</button>
            </form>

            <p class="text-center mt-3 mb-0">
                Já tem conta? <a asp-action="Login" class="text-success fw-semibold">Entrar</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
