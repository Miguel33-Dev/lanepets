@model PetshopCSharp.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-shell">
    <div class="auth-layout">
        <div class="auth-side">
            <div class="auth-crest">🐾</div>
            <h2>Bem-vindo de volta</h2>
            <p>Continue cuidando do seu pet com atendimento ágil, produtos confiáveis e serviços pensados para o bem-estar animal.</p>
            <ul class="auth-highlight-list">
                <li>✔ Agendamento rápido</li>
                <li>✔ Produtos para todos os pets</li>
                <li>✔ Entrega e acompanhamento</li>
            </ul>
        </div>

        <div class="card auth-form-panel">
            <div class="text-center mb-4">
                <div class="display-6 mb-2">🐾</div>
                <h3 class="text-success fw-bold mb-1">Entrar</h3>
                <p class="text-muted mb-0">Acesse sua conta para continuar cuidando do seu pet.</p>
            </div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-control" placeholder="seuemail@exemplo.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Senha" class="form-label">Senha</label>
                    <input asp-for="Senha" class="form-control" placeholder="Sua senha" type="password" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">Entrar</button>
            </form>

            <p class="text-center mt-3 mb-0">
                Não tem conta? <a asp-action="Register" class="text-success fw-semibold">Cadastre-se</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
