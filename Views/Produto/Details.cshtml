@using System.Globalization
@model PetshopCSharp.Models.Produto
@{
    ViewData["Title"] = "Detalhes do Produto";
    var ptBr = new CultureInfo("pt-BR");
}

<div class="container py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <div class="detail-image-wrap">
                <img src="@(string.IsNullOrWhiteSpace(Model.Imagem) ? "https://via.placeholder.com/800x600?text=Sem+Imagem" : Model.Imagem)"
                     alt="@Model.Nome"
                     class="detail-image" />
            </div>
        </div>

        <div class="col-lg-6">
            <div class="detail-info p-4">
                <span class="badge @(Model.Disponivel ? "bg-success" : "bg-secondary") mb-3">
                    @(Model.Disponivel ? "Disponível" : "Indisponível")
                </span>

                <h1 class="text-success fw-bold mb-3">@Model.Nome</h1>

                <div class="price-box mb-4">
                    <span class="label">Preço</span>
                    <span class="value">@Model.Preco.ToString("C2", ptBr)</span>
                </div>

                <p class="text-muted lead">@Model.Descricao</p>

                <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                    <span class="badge bg-light text-success border">Entrega em até 24h</span>
                    <span class="badge bg-light text-success border">Qualidade garantida</span>
                </div>

                @if (!Model.Disponivel)
                {
                    <button class="btn btn-secondary btn-lg w-100" type="button" disabled>Produto indisponível no momento</button>
                }
                else
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label for="quantity" class="fw-semibold text-success mb-0">Quantidade</label>
                            <input id="quantity" name="quantity" type="number" min="1" max="20" value="1" class="form-control" style="max-width: 120px;" />
                        </div>

                        <button class="btn btn-success btn-lg w-100" type="submit">Adicionar ao carrinho</button>
                    </form>
                }

                <div class="d-flex gap-2 mt-4 flex-wrap">
                    <a asp-action="Index" class="btn btn-outline-success">Voltar ao catálogo</a>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary">Ir para o carrinho</a>
                </div>
            </div>
        </div>
    </div>
</div>
